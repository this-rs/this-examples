{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "this modules",
  "version": "0.1.0",
  "identifier": "dev.thisrs.desktop-modules",
  "build": {
    "beforeDevCommand": "cd ui && trunk serve --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ui && trunk build --release",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "this · modules",
        "width": 1180,
        "height": 800,
        "minWidth": 420,
        "minHeight": 480,
        "label": "main",
        "decorations": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "iOS": {
      "developmentTeam": "YHCD3HX4Q9"
    }
  }
}
